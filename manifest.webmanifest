{
  "name": "Tally: receipts & money",
  "short_name": "Tally",
  "description": "Every item on your receipt, sorted. Read on your phone, with no upload, account or bank login. No subscription, no ads: a passion project, and open source.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0F172A",
  "theme_color": "#0F172A",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "lang": "en",
  "shortcuts": [
    { "name": "Add spending", "short_name": "Add", "url": "./#/add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a receipt", "short_name": "Scan", "url": "./#/scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "categories": [
    "finance",
    "productivity"
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*",
            "image/*",
            "application/octet-stream",
            "application/zip",
            "application/json",
            "application/pdf",
            "text/csv",
            "text/plain",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".mmbackup",
            ".csv",
            ".xlsx",
            ".json",
            ".zip",
            ".pdf"
          ]
        }
      ]
    }
  }
}
